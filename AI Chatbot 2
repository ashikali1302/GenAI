```python
# ============================================================
# ROLE-BASED GROQ AI CHATBOT
# Google Colab Version
# ============================================================


# ============================================================
# 1. INSTALL GROQ
# ============================================================

!pip install -q groq


# ============================================================
# 2. IMPORT LIBRARIES
# ============================================================

import os
import getpass
from groq import Groq


# ============================================================
# 3. GET GROQ API KEY SECURELY
# ============================================================

api_key = os.environ.get("GROQ_API_KEY")

# Try Google Colab Secrets
if not api_key:
    try:
        from google.colab import userdata
        api_key = userdata.get("GROQ_API_KEY")
    except Exception:
        pass

# Ask manually if key is not found
if not api_key:
    api_key = getpass.getpass("Enter your Groq API Key: ")


# ============================================================
# 4. INITIALIZE GROQ CLIENT
# ============================================================

client = Groq(api_key=api_key)


# ============================================================
# 5. AI ROLES
# ============================================================

roles = [
    {
        "id": 1,
        "name": "customer_support",
        "description": """
You are a customer support assistant.

Your job is to help customers with:
- Products
- Orders
- Delivery
- Returns
- Refunds
- Warranty

Be polite, professional and helpful.
Keep answers clear and easy to understand.
"""
    },

    {
        "id": 2,
        "name": "teacher",
        "description": """
You are an AI teacher.

Your job is to:
- Explain concepts in simple language
- Give practical examples
- Break difficult topics into smaller steps
- Explain concepts step-by-step
- Answer student questions clearly

Avoid unnecessary complexity.
"""
    },

    {
        "id": 3,
        "name": "programmer",
        "description": """
You are an expert Python programmer.

Your job is to help users:
- Write Python programs
- Debug Python code
- Explain Python concepts
- Solve programming problems
- Improve existing code

Provide clean, efficient and understandable solutions.
When giving code, explain the important parts.
"""
    }
]


# ============================================================
# 6. DISPLAY AVAILABLE ROLES
# ============================================================

print("\n==========================================")
print("          ROLE-BASED AI CHATBOT")
print("==========================================")

print("\nAvailable Roles:\n")

for role in roles:
    role_name = role["name"].replace("_", " ").title()
    print(f"{role['id']}. {role_name}")


# ============================================================
# 7. SELECT ROLE
# ============================================================

while True:

    try:

        role_choice = int(input("\nSelect Role (1-3): "))

        if 1 <= role_choice <= len(roles):
            break

        print("Invalid choice. Please select 1, 2 or 3.")

    except ValueError:

        print("Please enter a number.")


# Get selected role
selected_role = roles[role_choice - 1]

selected_role_name = selected_role["name"].replace("_", " ").title()

print("\nSelected Role:", selected_role_name)


# ============================================================
# 8. CONVERSATION HISTORY
# ============================================================

conversation_history = [

    {
        "role": "system",
        "content": selected_role["description"]
    }

]


# ============================================================
# 9. MODEL CONFIGURATION
# ============================================================

MODEL_NAME = "llama-3.3-70b-versatile"

TEMPERATURE = 0.7

MAX_TOKENS = 1024


# ============================================================
# 10. START CHAT
# ============================================================

print("\n==========================================")
print("              CHAT STARTED")
print("==========================================")

print("\nYou can start chatting with the AI.")

print("Type:")
print("  exit  → Exit chatbot")
print("  quit  → Exit chatbot")
print("  q     → Exit chatbot")


# ============================================================
# 11. CHAT LOOP
# ============================================================

while True:

    # --------------------------------------------------------
    # GET USER INPUT
    # --------------------------------------------------------

    try:

        user_input = input("\nYou: ")

    except EOFError:

        print("\nSession ended.")
        break


    # --------------------------------------------------------
    # REMOVE EXTRA SPACES
    # --------------------------------------------------------

    user_input = user_input.strip()


    # --------------------------------------------------------
    # CHECK EMPTY INPUT
    # --------------------------------------------------------

    if not user_input:

        continue


    # --------------------------------------------------------
    # CHECK EXIT COMMAND
    # --------------------------------------------------------

    if user_input.lower() in ["exit", "quit", "q"]:

        print("\nAI: Goodbye!")
        break


    # --------------------------------------------------------
    # ADD USER MESSAGE TO CONVERSATION
    # --------------------------------------------------------

    conversation_history.append(
        {
            "role": "user",
            "content": user_input
        }
    )


    # --------------------------------------------------------
    # SEND REQUEST TO GROQ
    # --------------------------------------------------------

    print("\nAI: ", end="", flush=True)

    try:

        completion = client.chat.completions.create(

            model=MODEL_NAME,

            messages=conversation_history,

            temperature=TEMPERATURE,

            max_completion_tokens=MAX_TOKENS,

            stream=True

        )


        # ----------------------------------------------------
        # RECEIVE STREAMING RESPONSE
        # ----------------------------------------------------

        full_response = ""


        for chunk in completion:

            # Get text from current chunk
            delta = chunk.choices[0].delta.content or ""

            # Print immediately
            print(delta, end="", flush=True)

            # Store complete response
            full_response += delta


        # Move to next line
        print()


        # ----------------------------------------------------
        # SAVE AI RESPONSE
        # ----------------------------------------------------

        conversation_history.append(
            {
                "role": "assistant",
                "content": full_response
            }
        )


    # --------------------------------------------------------
    # ERROR HANDLING
    # --------------------------------------------------------

    except Exception as e:

        print("\n\n[ERROR]")
        print(e)

        # Remove the user's message because the request failed
        conversation_history.pop()


# ============================================================
# END
# ============================================================

print("\nChatbot closed.")
```
