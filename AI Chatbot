from groq import Groq


# ============================================================
# 3. GROQ API KEY
# ============================================================

API_KEY = "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"

client = Groq(api_key=API_KEY)


# ============================================================
# 4. AI ROLES
# ============================================================

roles = [
    {
        "id": 1,
        "name": "customer_support",
        "description": """
You are a customer support assistant.

Help customers with:
- Products
- Orders
- Delivery
- Returns
- Refunds
- Warranty

Be polite, professional and helpful.
"""
    },

    {
        "id": 2,
        "name": "teacher",
        "description": """
You are an AI teacher.

Explain concepts in simple language.
Give examples.
Explain difficult topics step-by-step.
Keep explanations clear and easy to understand.
"""
    },

    {
        "id": 3,
        "name": "programmer",
        "description": """
You are an expert Python programmer.

Help users:
- Write Python code
- Debug Python code
- Explain Python concepts
- Solve programming problems
- Improve existing code

Provide clean, simple and efficient solutions.
"""
    }
]


# ============================================================
# 5. DISPLAY ROLES
# ============================================================

print("\n==========================================")
print("          ROLE-BASED AI CHATBOT")
print("==========================================")

print("\nAvailable Roles:\n")

for role in roles:
    print(
        f"{role['id']}. "
        f"{role['name'].replace('_', ' ').title()}"
    )


# ============================================================
# 6. SELECT ROLE
# ============================================================

while True:

    try:
        role_choice = int(input("\nSelect Role (1-3): "))

        if 1 <= role_choice <= len(roles):
            break

        print("Please select 1, 2 or 3.")

    except ValueError:
        print("Please enter a number.")


selected_role = roles[role_choice - 1]

print(
    "\nSelected Role:",
    selected_role["name"].replace("_", " ").title()
)


# ============================================================
# 7. CONVERSATION HISTORY
# ============================================================

conversation_history = [
    {
        "role": "system",
        "content": selected_role["description"]
    }
]


# ============================================================
# 8. MODEL SETTINGS
# ============================================================

MODEL_NAME = "llama-3.3-70b-versatile"

TEMPERATURE = 0.7

MAX_TOKENS = 1024


# ============================================================
# 9. START CHAT
# ============================================================

print("\n==========================================")
print("              CHAT STARTED")
print("==========================================")

print("\nType 'exit', 'quit' or 'q' to stop.")


# ============================================================
# 10. CHAT LOOP
# ============================================================

while True:

    try:
        user_input = input("\nYou: ")

    except EOFError:
        break


    # Remove extra spaces
    user_input = user_input.strip()


    # Ignore empty input
    if not user_input:
        continue


    # Exit commands
    if user_input.lower() in ["exit", "quit", "q"]:

        print("\nAI: Goodbye!")
        break


    # ========================================================
    # ADD USER MESSAGE
    # ========================================================

    conversation_history.append(
        {
            "role": "user",
            "content": user_input
        }
    )


    # ========================================================
    # CALL GROQ API
    # ========================================================

    print("\nAI: ", end="", flush=True)

    try:

        completion = client.chat.completions.create(

            model=MODEL_NAME,

            messages=conversation_history,

            temperature=TEMPERATURE,

            max_completion_tokens=MAX_TOKENS,

            stream=True
        )


        # ====================================================
        # STREAM AI RESPONSE
        # ====================================================

        full_response = ""

        for chunk in completion:

            delta = chunk.choices[0].delta.content or ""

            print(delta, end="", flush=True)

            full_response += delta


        print()


        # ====================================================
        # SAVE AI RESPONSE
        # ====================================================

        conversation_history.append(
            {
                "role": "assistant",
                "content": full_response
            }
        )


    # ========================================================
    # ERROR HANDLING
    # ========================================================

    except Exception as e:

        print(f"\n[ERROR]: {e}")

        # Remove failed user message
        conversation_history.pop()


# ============================================================
# END
# ============================================================

print("\nChatbot closed.")
