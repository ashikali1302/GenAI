```python
# Install first:
# pip install groq

from groq import Groq

# ============================================================
# GROQ CLIENT
# ============================================================

API_KEY = "YOUR_GROQ_API_KEY"

client = Groq(api_key=API_KEY)


# ============================================================
# ROLES
# ============================================================

roles = [
    {
        "id": 1,
        "name": "customer_support",
        "description": """
You are a customer support assistant.

Help customers with:
- Products
- Orders
- Delivery
- Returns
- Refunds
- Warranty

Be polite, professional and helpful.
"""
    },

    {
        "id": 2,
        "name": "teacher",
        "description": """
You are an AI teacher.

Explain concepts in simple language.
Give practical examples.
Break difficult concepts into smaller steps.
Ask questions when clarification is needed.
"""
    },

    {
        "id": 3,
        "name": "programmer",
        "description": """
You are an expert Python programmer.

Help users:
- Write Python code
- Debug Python code
- Explain Python concepts
- Improve code
- Solve programming problems

Provide clean, simple and understandable solutions.
"""
    }
]


# ============================================================
# DISPLAY ROLES
# ============================================================

def display_roles():

    print("\n==============================")
    print("       AI CHATBOT")
    print("==============================")

    print("\nAvailable Roles:")

    for role in roles:
        print(f"{role['id']}. {role['name'].replace('_', ' ').title()}")


# ============================================================
# SELECT ROLE
# ============================================================

def select_role():

    while True:

        display_roles()

        try:
            role_choice = int(input("\nSelect Role (1-3): "))

            if 1 <= role_choice <= len(roles):
                selected_role = roles[role_choice - 1]

                print(
                    f"\nSelected Role: "
                    f"{selected_role['name'].replace('_', ' ').title()}"
                )

                return selected_role

            else:
                print("\nInvalid choice. Please select 1, 2 or 3.")

        except ValueError:
            print("\nPlease enter a number.")


# ============================================================
# CHATBOT
# ============================================================

def chatbot(selected_role):

    # Conversation history
    messages = [
        {
            "role": "system",
            "content": selected_role["description"]
        }
    ]

    print("\n==============================")
    print("        CHAT STARTED")
    print("==============================")

    print("\nType 'exit', 'quit' or 'bye' to stop.")

    while True:

        # Get user input
        user_input = input("\nYou: ").strip()

        # Check empty input
        if not user_input:
            print("Please enter something.")
            continue

        # Exit
        if user_input.lower() in ["exit", "quit", "bye"]:
            print("\nAI: Goodbye!")
            break

        # Add user message to conversation
        messages.append(
            {
                "role": "user",
                "content": user_input
            }
        )

        try:

            # Send conversation to Groq
            response = client.chat.completions.create(
                model="openai/gpt-oss-20b",
                messages=messages,
                temperature=0.5
            )

            # Get AI response
            answer = response.choices[0].message.content

            # Display AI response
            print("\nAI:", answer)

            # Store AI response
            messages.append(
                {
                    "role": "assistant",
                    "content": answer
                }
            )

        except Exception as error:

            print("\nError occurred:")
            print(error)

            # Remove the user's message if API call failed
            messages.pop()


# ============================================================
# MAIN PROGRAM
# ============================================================

def main():

    selected_role = select_role()

    chatbot(selected_role)


# ============================================================
# START PROGRAM
# ============================================================

if __name__ == "__main__":
    main()
```
