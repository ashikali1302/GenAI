# ============================================================
# 7. CLEAN TEXT
# ============================================================

def clean_text(text):

    text = text.replace(
        "\n",
        " "
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ============================================================
# 8. CREATE TEXT CHUNKS
# ============================================================

def create_chunks(
    text,
    chunk_size=1000,
    overlap=200
):

    chunks = []

    start = 0

    while start < len(text):

        end = start + chunk_size

        chunk = text[start:end]

        if chunk.strip():

            chunks.append(
                chunk.strip()
            )

        start += (
            chunk_size - overlap
        )

    return chunks


# ============================================================
# 9. READ PDF
# ============================================================

def extract_pdf_text(file_path):

    reader = PdfReader(
        file_path
    )

    complete_text = ""

    for page_number, page in enumerate(
        reader.pages,
        start=1
    ):

        page_text = page.extract_text()

        if page_text:

            complete_text += (
                f"\n[Page {page_number}]\n"
            )

            complete_text += page_text

    return clean_text(
        complete_text
    )


# ============================================================
# 10. CREATE FAISS DATABASE
# ============================================================

def create_vector_database(
    chunks
):

    global tfidf_vectorizer

    print(
        "\nCreating document vectors..."
    )

    tfidf_vectorizer = TfidfVectorizer(

        stop_words="english",

        max_features=10000,

        ngram_range=(1, 2)

    )


    # Convert text into vectors
    vectors = (
        tfidf_vectorizer
        .fit_transform(chunks)
        .toarray()
    )


    vectors = vectors.astype(
        "float32"
    )


    # Normalize
    faiss.normalize_L2(
        vectors
    )


    dimension = vectors.shape[1]


    # FAISS similarity index
    index = faiss.IndexFlatIP(
        dimension
    )


    index.add(
        vectors
    )


    print(
        "FAISS database created."
    )

    return index


# ============================================================
# 11. PROCESS PDF
# ============================================================

def process_pdf(file):

    global document_chunks
    global vector_db
    global document_name


    if file is None:

        return (
            "❌ Please upload a PDF first."
        )


    try:

        print(
            "\nReading PDF..."
        )


        # Extract text
        text = extract_pdf_text(
            file
        )


        if not text:

            return (
                "❌ No readable text "
                "found in this PDF."
            )


        # Create chunks
        chunks = create_chunks(
            text
        )


        if not chunks:

            return (
                "❌ Could not create "
                "document chunks."
            )


        # Save chunks
        document_chunks = chunks


        # Save document name
        document_name = os.path.basename(
            file
        )


        # Create vector database
        vector_db = create_vector_database(
            document_chunks
        )


        return (
            "✅ PDF processed successfully!\n\n"

            "📄 Document: "
            + document_name
            + "\n\n"

            "🧩 Chunks: "
            + str(len(document_chunks))
            + "\n\n"

            "You can now ask questions "
            "about your document."
        )


    except Exception as e:

        return (
            "❌ PDF processing error:\n\n"
            + str(e)
        )


# ============================================================
# 12. RETRIEVE RELEVANT CHUNKS
# ============================================================

def retrieve_chunks(
    question,
    top_k=5
):

    global vector_db
    global tfidf_vectorizer
    global document_chunks


    if vector_db is None:

        return []


    # Convert question to vector
    question_vector = (
        tfidf_vectorizer
        .transform([question])
        .toarray()
    )


    question_vector = (
        question_vector
        .astype("float32")
    )


    # Normalize
    faiss.normalize_L2(
        question_vector
    )


    # Search
    scores, indexes = (
        vector_db.search(
            question_vector,
            min(
                top_k,
                len(document_chunks)
            )
        )
    )


    results = []


    for score, index in zip(
        scores[0],
        indexes[0]
    ):

        if index >= 0:

            results.append({

                "text":
                    document_chunks[index],

                "score":
                    float(score)

            })


    return results


# ============================================================
# 13. GENERATE AI ANSWER
# ============================================================

def generate_answer(
    question,
    history
):

    global vector_db


    # Empty input
    if not question.strip():

        return (
            "",
            history
        )


    # No document
    if vector_db is None:

        answer = (
            "Please upload and process "
            "a PDF first."
        )

        history.append(
            (
                question,
                answer
            )
        )

        return (
            "",
            history
        )


    # ========================================================
    # RETRIEVE CONTEXT
    # ========================================================

    results = retrieve_chunks(
        question,
        top_k=5
    )


    # ========================================================
    # BUILD CONTEXT
    # ========================================================

    context = ""


    for i, result in enumerate(
        results,
        start=1
    ):

        context += (

            "\n\n"
            "========== CONTEXT "
            + str(i)
            + " ==========\n"

            + result["text"]

        )


    # ========================================================
    # SYSTEM PROMPT
    # ========================================================

    system_prompt = """

You are a professional RAG AI assistant.

Answer questions using the provided
document context.

Rules:

1. Use the document context as the
   primary source.

2. Do not invent information.

3. If the answer cannot be found
   in the document, say:

   "The answer is not available
   in the uploaded document."

4. Give clear and concise answers.

5. Use bullet points when useful.

6. Mention page numbers when
   available and relevant.

"""


    # ========================================================
    # USER PROMPT
    # ========================================================

    user_prompt = (

        "DOCUMENT CONTEXT:\n"

        + context

        + "\n\nUSER QUESTION:\n"

        + question

        + "\n\n"

        + "Answer the question using "
          "the document context."

    )


    # ========================================================
    # GROQ MESSAGES
    # ========================================================

    messages = [

        {
            "role":
                "system",

            "content":
                system_prompt
        }

    ]


    # Add previous messages
    for old_user, old_ai in history:

        messages.append({

            "role":
                "user",

            "content":
                old_user

        })

        messages.append({

            "role":
                "assistant",

            "content":
                old_ai

        })


    # Add current question
    messages.append({

        "role":
            "user",

        "content":
            user_prompt

    })


    # ========================================================
    # GROQ API
    # ========================================================

    try:

        response = (
            client
            .chat
            .completions
            .create(

                model=
                    MODEL_NAME,

                messages=
                    messages,

                temperature=
                    0.3,

                max_completion_tokens=
                    1024,

                stream=
                    False

            )
        )


        answer = (
            response
            .choices[0]
            .message
            .content
        )


    except Exception as e:

        answer = (
            "❌ Groq API Error:\n\n"
            + str(e)
        )


    # ========================================================
    # SOURCES
    # ========================================================

    if results:

        answer += (
            "\n\n---\n"
            "**Sources used:**\n"
        )


        for i, result in enumerate(
            results[:3],
            start=1
        ):

            answer += (

                "- Context "
                + str(i)

                + " (similarity: "

                + f"{result['score']:.2f}"

                + ")\n"

            )


    # ========================================================
    # SAVE CHAT
    # ========================================================

    history.append(
        (
            question,
            answer
        )
    )


    return (
        "",
        history
    )


